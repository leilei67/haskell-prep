[
 {
  "id": "notation:0",
  "q": "What does `x :: T` mean?",
  "a": "`x` has type `T`.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:1",
  "q": "What does the part before `=>` in a type mean?",
  "a": "A constraint: the type variables must be instances of those classes. `Eq a => a -> a -> Bool` works for any `a` with an `Eq` instance.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:2",
  "q": "In kinds, what is `*`?",
  "a": "The old name for `Type`: the kind of ordinary types like `Int`, `Bool`, `[Char]`.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:3",
  "q": "What kind does `Maybe` have, and why?",
  "a": "`* -> *`. It needs one more type (`Maybe Int`) before it is an ordinary type.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:4",
  "q": "What kind does `Either` have?",
  "a": "`* -> * -> *`. It needs two types, e.g. `Either String Int`.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:5",
  "q": "What is the kind `Constraint`?",
  "a": "The kind of things that go before `=>`, e.g. `Eq a`. `Eq :: * -> Constraint`.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:6",
  "q": "What is a line like `type Functor :: (* -> *) -> Constraint`?",
  "a": "A kind signature: `Functor` takes a type constructor of kind `* -> *` and gives a constraint.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:7",
  "q": "What does a trailing `#` mean in names like `Int#` or `I#`?",
  "a": "An unboxed primitive: a raw machine value inside GHC. `data Int = I# Int#` boxes a raw machine int. You never write these.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:8",
  "q": "What does `HasCallStack =>` in a signature mean?",
  "a": "If the function crashes, the error message includes the call site. Seen on partial functions: `head`, `tail`, `init`, `last`, `(!!)`, `cycle`, `error`, `undefined`.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:9",
  "q": "What does `{-# MINIMAL ... #-}` tell you?",
  "a": "Which methods you must define to write an instance; the rest have defaults. A comma means AND, `|` means OR.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:10",
  "q": "In `:browse Prelude`, why are some names printed fully qualified (e.g. `GHC.Internal.Data.Foldable.toList`)?",
  "a": "They are class methods that exist but are NOT exported from the Prelude under their short name. You need an import (e.g. `Data.Foldable`) to call them.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:11",
  "q": "What is WHNF?",
  "a": "Weak head normal form: evaluated just far enough to see the outermost constructor or lambda. `seq` and `$!` evaluate to WHNF.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:12",
  "q": "What does a superclass mean, e.g. `class Eq a => Ord a`?",
  "a": "Every instance of `Ord` must also be an instance of `Eq`.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:13",
  "q": "Difference between `data`, `newtype` and `type`?",
  "a": "`data`: a new type with constructors. `newtype`: a new type with exactly one constructor and one field, no runtime cost. `type`: just another name (a synonym) for an existing type.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "notation:14",
  "q": "Which imports give you the qualified-only methods in the browse output?",
  "a": "`fold`, `foldMap'`, `foldr'`, `toList`: `Data.Foldable`.\n`log1p`, `expm1`, `log1pexp`, `log1mexp`: `Numeric`.\n`sconcat`, `stimes`: `Data.Semigroup`.\n`readPrec`, `readListPrec`: `Text.Read`.",
  "group": "notation",
  "topic": "notation",
  "prio": "core"
 },
 {
  "id": "types:15",
  "q": "Definition of `Bool`?",
  "a": "`data Bool = False | True`. Kind `*`. `False < True`.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:16",
  "q": "Definition of `Maybe`?",
  "a": "`data Maybe a = Nothing | Just a`. Kind `* -> *`. An optional value.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:17",
  "q": "Definition of `Either`?",
  "a": "`data Either a b = Left a | Right b`. Kind `* -> * -> *`. Convention: `Left` = error, `Right` = success.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:18",
  "q": "Definition of `Ordering`?",
  "a": "`data Ordering = LT | EQ | GT`. The result of `compare`. It is a Monoid: `compare a1 a2 <> compare b1 b2` compares lexicographically.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:19",
  "q": "What is `String`?",
  "a": "`type String = [Char]`. A list of characters, so every list function works on it.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:20",
  "q": "What is `FilePath`?",
  "a": "`type FilePath = String`. Just a readable synonym.",
  "group": "types",
  "topic": "types",
  "prio": "useful"
 },
 {
  "id": "types:21",
  "q": "What is `ShowS`?",
  "a": "`type ShowS = String -> String`. Text waiting to have more text appended; composing with `.` avoids repeated `++` copying.",
  "group": "types",
  "topic": "types",
  "prio": "rare"
 },
 {
  "id": "types:22",
  "q": "What is `ReadS a`?",
  "a": "`type ReadS a = String -> [(a, String)]`. An old-style parser returning every (value, leftover input) parse. `[]` means failure.",
  "group": "types",
  "topic": "types",
  "prio": "useful"
 },
 {
  "id": "types:23",
  "q": "What is `Rational`?",
  "a": "`type Rational = Ratio Integer`. Exact fractions; build with `%` from `Data.Ratio`: `1 % 3 + 1 % 6 == 1 % 2`.",
  "group": "types",
  "topic": "types",
  "prio": "useful"
 },
 {
  "id": "types:24",
  "q": "What is `IOError`?",
  "a": "`type IOError = IOException`. The type of I/O failures such as file not found.",
  "group": "types",
  "topic": "types",
  "prio": "rare"
 },
 {
  "id": "types:25",
  "q": "What is `Int`?",
  "a": "A fixed-size machine integer (64-bit on your Mac), `data Int = I# Int#`. Wraps on overflow: `maxBound + 1 == (minBound :: Int)`.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:26",
  "q": "What is `Integer`?",
  "a": "An unbounded integer. Constructors `IS` (small, fits a machine word), `IP` (big positive), `IN` (big negative). Integer literals default to `Integer`.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:27",
  "q": "What is `Word`?",
  "a": "An unsigned machine integer, `data Word = W# Word#`. `(0 :: Word) - 1 == 18446744073709551615`.",
  "group": "types",
  "topic": "types",
  "prio": "useful"
 },
 {
  "id": "types:28",
  "q": "What is `Double` vs `Float`?",
  "a": "`Double`: 64-bit IEEE float (`D# Double#`). `Float`: 32-bit (`F# Float#`), less precise. Use `Double` by default.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:29",
  "q": "What is `Char`?",
  "a": "One Unicode code point, `data Char = C# Char#`. `maxBound :: Char == '\\1114111'`.",
  "group": "types",
  "topic": "types",
  "prio": "core"
 },
 {
  "id": "types:30",
  "q": "How is `IO a` represented inside GHC?",
  "a": "`newtype IO a = IO (State# RealWorld -> (# State# RealWorld, a #))`: a function from a world token to a new world token plus a result. Passing the token along orders the side effects.",
  "group": "types",
  "topic": "types",
  "prio": "rare"
 },
 {
  "id": "types:31",
  "q": "What is `(~)`?",
  "a": "Type equality. `type (~) :: forall k. k -> k -> Constraint`. `(a ~ Int) => ...` means `a` must be `Int`. Built into the compiler; works for types of any kind.",
  "group": "types",
  "topic": "types",
  "prio": "rare"
 },
 {
  "id": "class:Functor:purpose",
  "q": "Class `Functor`: what is it for?",
  "a": "Things you can map a function over without changing their shape. Laws: `fmap id == id`, `fmap (f . g) == fmap f . fmap g`.",
  "group": "class-purpose",
  "topic": "class:Functor",
  "prio": "core"
 },
 {
  "id": "class:Functor:kind",
  "q": "Class `Functor`: kind?",
  "a": "`Functor :: (* -> *) -> Constraint`",
  "group": "class-kind",
  "topic": "class:Functor",
  "prio": "core"
 },
 {
  "id": "class:Functor:sup",
  "q": "Class `Functor`: superclass(es)?",
  "a": "none",
  "group": "class-sup",
  "topic": "class:Functor",
  "prio": "core"
 },
 {
  "id": "class:Functor:methods",
  "q": "Class `Functor`: all methods listed in the Prelude browse?",
  "a": "`fmap`, `(<$)`",
  "group": "class-methods",
  "topic": "class:Functor",
  "prio": "core"
 },
 {
