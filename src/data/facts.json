 {
  "id": "compare:148",
  "q": "`pure` vs `return`?",
  "a": "Identical behaviour. `pure` needs Applicative, `return` needs Monad.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:149",
  "q": "`traverse` vs `mapM`, `sequenceA` vs `sequence`?",
  "a": "Same behaviour; the first of each pair needs only Applicative, the second needs Monad.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:150",
  "q": "`mapM` vs `mapM_`?",
  "a": "`mapM` collects results in the container; `mapM_` discards them and returns `()`.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:151",
  "q": "`(<>)` vs `mappend`?",
  "a": "Same thing; `mappend` is the old Monoid name.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:152",
  "q": "`fmap` vs `(<$>)` vs `(<$)`?",
  "a": "`(<$>)` is infix `fmap`. `(<$)` replaces contents with a constant.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:153",
  "q": "`(>>=)` vs `(=<<)`?",
  "a": "Same bind, flipped arguments: `m >>= f == f =<< m`.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:154",
  "q": "`($)` vs `($!)` vs `seq`?",
  "a": "`$` plain application. `$!` forces the argument first. `seq a b` forces `a`, returns `b`.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:155",
  "q": "`curry` vs `uncurry`?",
  "a": "`curry`: pair function to two-argument function. `uncurry`: the reverse.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:156",
  "q": "`lines`/`unlines` vs `words`/`unwords`?",
  "a": "`lines` splits on newlines, `words` on any whitespace. `unlines` adds a newline after each; `unwords` joins with spaces.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:157",
  "q": "`scanl` vs `scanl1` vs `scanr` vs `scanr1`?",
  "a": "`scanl (+) 0 [1,2,3] == [0,1,3,6]`\n`scanl1 (+) [1,2,3] == [1,3,6]`\n`scanr (+) 0 [1,2,3] == [6,5,3,0]`\n`scanr1 (+) [1,2,3] == [6,5,3]`",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:158",
  "q": "`fromIntegral` vs `realToFrac` vs `toInteger` vs `toRational`?",
  "a": "`fromIntegral`: Integral to any Num. `realToFrac`: Real to any Fractional. `toInteger`: to Integer. `toRational`: exact to Rational.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:159",
  "q": "`read` vs `reads` vs `readIO` vs `readLn`?",
  "a": "`read`: pure, crashes on failure. `reads`: returns [(value, rest)]. `readIO`: in IO, throws on failure. `readLn`: getLine then readIO.",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
  "id": "compare:160",
  "q": "`putStr` vs `putStrLn` vs `print`?",
  "a": "`putStr` no newline; `putStrLn` adds newline; `print` = putStrLn . show (strings get quotes).",
  "group": "compare",
  "topic": "compare",
  "prio": "core"
 },
 {
